<Window x:Class="VtuberBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="640"
        Height="600"
        MinWidth="560"
        MinHeight="520">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding ApplicationName}" FontSize="22"/>
            <TextBlock Text="{Binding Version}"/>
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Iniciar"
                    Click="StartButton_Click"
                    IsEnabled="{Binding CanStart}"
                    Margin="0,0,8,0"/>
            <Button Content="Detener"
                    Click="StopButton_Click"
                    IsEnabled="{Binding CanStop}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox x:Name="CommandInput"
                     Width="430"
                     MinWidth="280"
                     KeyDown="CommandInput_KeyDown"
                     VerticalContentAlignment="Center"/>
            <Button Content="Ejecutar"
                    Click="ExecuteButton_Click"
                    IsEnabled="{Binding CanExecute}"
                    Margin="8,0,0,0"
                    Padding="14,4"/>
        </StackPanel>

        <TextBox Grid.Row="3"
                 Text="{Binding Result}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="72"
                 Margin="0,12,0,0"/>

        <GroupBox Grid.Row="4" Header="Performance / Health" Margin="0,12,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuDisplay}" Margin="0,0,16,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="RAM" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding RamDisplay}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuDisplay}" Margin="0,0,16,6"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="FPS" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding FpsDisplay}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Perfil" Margin="0,0,8,6"/>
                <ComboBox x:Name="ProfileComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile, Mode=OneWay}"
                          SelectionChanged="ProfileComboBox_SelectionChanged"
                          IsEnabled="{Binding CanSelectProfile}"
                          Margin="0,0,16,6"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Health" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding HealthDisplay}" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Intervalo" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SamplingIntervalDisplay}" Margin="0,0,16,0"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Última muestra" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LastSampleDisplay}" Margin="0,0,0,0"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="5" Header="Actividad" Margin="0,12,0,0">
            <ListBox ItemsSource="{Binding Activity}"/>
        </GroupBox>
    </Grid>
</Window>
