<Window x:Class="VtuberBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="560"
        Height="430"
        MinWidth="480"
        MinHeight="360">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding ApplicationName}" FontSize="22"/>
            <TextBlock Text="{Binding Version}"/>
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Iniciar" Click="StartButton_Click" IsEnabled="{Binding CanStart}" Margin="0,0,8,0"/>
            <Button Content="Detener" Click="StopButton_Click" IsEnabled="{Binding CanStop}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox x:Name="CommandInput"
                     Width="380"
                     MinWidth="240"
                     KeyDown="CommandInput_KeyDown"
                     VerticalContentAlignment="Center"/>
            <Button Content="Ejecutar"
                    Click="ExecuteButton_Click"
                    IsEnabled="{Binding CanExecute}"
                    Margin="8,0,0,0"
                    Padding="14,4"/>
        </StackPanel>

        <TextBox Grid.Row="3"
                 Text="{Binding Result}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="72"
                 Margin="0,12,0,0"/>

        <GroupBox Grid.Row="4" Header="Actividad" Margin="0,12,0,0">
            <ListBox ItemsSource="{Binding Activity}"/>
        </GroupBox>
    </Grid>
</Window>
